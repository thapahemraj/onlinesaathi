 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\"></path><path d=\"m21 3 1 11h-2\"></path><path d=\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\"></path><path d=\"M3 4h8\"></path></svg></span> Sales & agents</h3><div class=\"mem\"><div class=\"avatar s-amber\">ST</div><div><b>Suresh Thapa</b><small>Agent Associate</small></div></div></div>\n    <div class=\"card reveal\" style=\"background:var(--tint)\"><h3><span class=\"chip c-green\" style=\"margin:0;width:40px;height:40px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0\"></path><circle cx=\"12\" cy=\"8\" r=\"2\"></circle><path d=\"M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712\"></path></svg></span> Field network</h3><p style=\"font-size:40px;font-weight:800;color:var(--green);margin-top:10px\" data-count=\"2000\" data-suf=\"+\">2000+</p><p>Saathis serving their communities across states.</p><a class=\"link\" href=\"/saathi/\">Become a Saathi <svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div>\n  </div>\n</div></section>\n<div class=\"chapter\" id=\"careers\"><div class=\"wrap\"><span class=\"cnum\">04</span><div><b>Field network & careers</b><small>2000+ Saathis and opportunities to join us</small></div></div></div>\n<section class=\"sec-alt\" id=\"careers\"><div class=\"wrap split\">\n  <div class=\"reveal\"><span class=\"eyebrow\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0\"></path><circle cx=\"12\" cy=\"8\" r=\"2\"></circle><path d=\"M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712\"></path></svg> Field network</span><h2>2000+ Saathis — our biggest team</h2><p class=\"lead\">Local entrepreneurs, trained by us, who bring services to workers’ doorsteps in their own language.</p><a class=\"btn btn-green\" style=\"margin-top:22px\" href=\"/saathi/\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><line x1=\"19\" x2=\"19\" y1=\"8\" y2=\"14\"></line><line x1=\"22\" x2=\"16\" y1=\"11\" y2=\"11\"></line></svg> Become a Saathi</a></div>\n  <div class=\"card reveal\"><div class=\"teamviz\" id=\"tv\"></div><p style=\"margin-top:14px;font-size:13.5px\">Each dot represents ~20 Saathis.</p></div>\n</div></section>\n<section><div class=\"wrap split\">\n  <div class=\"reveal\"><span class=\"eyebrow\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path><rect width=\"20\" height=\"14\" x=\"2\" y=\"6\" rx=\"2\"></rect></svg> Careers</span><h2>Work with purpose</h2><p class=\"lead\">We’re always looking for people who care about dignity at work — in field operations, technology, partnerships and support.</p>\n    <ul class=\"ticks\"><li><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg> Real impact on workers’ lives, every day</li><li><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg> Learn across tech, field and partnerships</li><li><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg> Grow with a fast-scaling social enterprise</li></ul></div>\n  <form class=\"formcard reveal\" data-form=\"Career interest\">\n    <h3 style=\"margin-bottom:18px\">Share your interest</h3>\n    <div class=\"row2\"><div class=\"field\"><label>Name</label><input name=\"Name\" required></div><div class=\"field\"><label>Mobile</label><input name=\"Mobile\" type=\"tel\" required></div></div>\n    <div class=\"field\"><label>Area</label><select name=\"Area\"><option>Field operations</option><option>Technology</option><option>Partnerships</option><option>Customer support</option><option>Finance & accounts</option></select></div>\n    <div class=\"field\"><label>LinkedIn or CV link</label><input name=\"Profile\"></div>\n    <button class=\"btn btn-blue\" type=\"submit\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"></path><path d=\"m21.854 2.147-10.94 10.939\"></path></svg> Send</button><div class=\"ok\">Thank you! WhatsApp has opened with your details — just press send.</div>\n  </form>\n</div></section>\n\n</main>\n\n<a class=\"wa\" href=\"https://wa.me/919099005251\" target=\"_blank\" rel=\"noopener\" aria-label=\"Chat on WhatsApp\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"></path></svg></a>\n\n",
  "mainBody": "\n<div class=\"phero\"><div class=\"wrap phero-grid\"><div><span class=\"eyebrow\" style=\"\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg> Our team</span><h2 style=\"font-size:clamp(32px,4.4vw,54px);margin-top:14px\">People who know <span style=\"color:var(--blue)\">the last mile</span></h2><p class=\"lead\" style=\"margin-top:16px\">A founder-led team combining grassroots insight, technology and operations — guided by sector mentors and powered by 2000+ Saathis in the field.</p></div><div class=\"card reveal\"><h3 style=\"margin-bottom:6px\">Our team at a glance</h3><p style=\"margin-bottom:16px\">Core team of 13, plus a field network of 2000+ Saathis.</p>\n    <div class=\"prog\">\n      <div class=\"pr\"><span>Leadership <em>4</em></span><div class=\"track\"><div class=\"fill s-blue\" style=\"--w:30.8%\"></div></div></div>\n      <div class=\"pr\"><span>Support associates <em>5</em></span><div class=\"track\"><div class=\"fill s-green\" style=\"--w:38.5%\"></div></div></div>\n      <div class=\"pr\"><span>Partner relationship associates <em>2</em></span><div class=\"track\"><div class=\"fill s-red\" style=\"--w:15.4%\"></div></div></div>\n      <div class=\"pr\"><span>Account associates <em>2</em></span><div class=\"track\"><div class=\"fill s-navy\" style=\"--w:15.4%\"></div></div></div>\n    </div></div></div></div>\n\n<div class=\"chapter\" id=\"directors\"><div class=\"wrap\"><span class=\"cnum\">01</span><div><b>Directors</b><small>Our board of directors</small></div></div></div>\n<section><div class=\"wrap\">\n  <div class=\"center reveal\" style=\"margin-bottom:36px\"><span class=\"eyebrow\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z\"></path><path d=\"M5 21h14\"></path></svg> Board of directors</span><h2>Directors</h2></div>\n  <div class=\"grid g2\">\n    <div class=\"card reveal person2\"><div class=\"ph s-blue\">NS</div><div><h3>Naresh Sijapati</h3><b style=\"color:var(--blue);font-size:14px\">Founder, CEO & Director</b><p>Leads strategy, last-mile field operations and community entrepreneurship. A former child labourer who continued his education and worked with Teach for India, Naresh founded the first digital mobile office for migrants in 2015, led COVID-19 relief for 12,500+ families, the 5,100 km #WalkForMigrant and the 11,111 km Walk for Dignity.</p></div></div>\n    <div class=\"card reveal person2\"><div class=\"ph s-green\">BB</div><div><h3>Bhavika Bhogekar</h3><b style=\"color:var(--green);font-size:14px\">Co-founder, COO & Director</b><p>Leads finance, HR and company operations — keeping Online Saathi compliant, efficient and ready to grow.</p></div></div>\n  </div>\n</div></section>\n<div class=\"chapter\" id=\"advisors\"><div class=\"wrap\"><span class=\"cnum\">02</span><div><b>Mentors & advisors</b><small>Guided by sector leaders</small></div></div></div>\n<section class=\"sec-alt\"><div class=\"wrap\">\n  <div class=\"center reveal\" style=\"margin-bottom:70px\"><span class=\"eyebrow\" style=\"background:var(--gtint);color:var(--green)\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"></path><path d=\"M9 18h6\"></path><path d=\"M10 22h4\"></path></svg> Mentors & advisors</span><h2>Mentors & advisors</h2></div>\n  <div class=\"leader\">\n    <div class=\"lcard reveal\"><div class=\"top\" style=\"background:var(--tint)\"><div class=\"ph\" style=\"color:var(--blue)\">VM</div></div><div class=\"bd\"><h3>Vivek Mathur</h3><small>Elevation Capital</small><p>Venture capital and scaling guidance.</p></div></div>\n    <div class=\"lcard reveal\"><div class=\"top\" style=\"background:var(--gtint)\"><div class=\"ph\" style=\"color:var(--green)\">UT</div></div><div class=\"bd\"><h3>Ujwal Thakar</h3><small>former Give / PwC India</small><p>Philanthropy, governance and partnerships.</p></div></div>\n    <div class=\"lcard reveal\"><div class=\"top\" style=\"background:var(--rtint)\"><div class=\"ph\" style=\"color:var(--red)\">NJ</div></div><div class=\"bd\"><h3>Nikunj Jhaveri</h3><small>System Plus</small><p>Technology and product engineering.</p></div></div>\n    <div class=\"lcard reveal\"><div class=\"top\" style=\"background:#FFF4DC\"><div class=\"ph\" style=\"color:#B57800\">DT</div></div><div class=\"bd\"><h3>Dinesh Tyagi, IAS (retd.)</h3><small>former CEO, CSC e-Gov India</small><p>Public digital service delivery at national scale.</p></div></div>\n  </div>\n</div></section>\n<div class=\"chapter\" id=\"our-team\"><div class=\"wrap\"><span class=\"cnum\">03</span><div><b>Our team</b><small>Every department and every member</small></div></div></div>\n<section><div class=\"wrap\">\n  <div class=\"dept\">\n    <div class=\"card reveal\"><h3><span class=\"chip c-blue\" style=\"margin:0;width:40px;height:40px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z\"></path><path d=\"M5 21h14\"></path></svg></span> Leadership</h3><div class=\"mem\"><div class=\"avatar s-blue\">NS</div><div><b>Naresh Sijapati</b><small>Founder, CEO & Director</small></div></div><div class=\"mem\"><div class=\"avatar s-green\">BB</div><div><b>Bhavika Bhogekar</b><small>Co-founder, COO & Director</small></div></div></div>\n    <div class=\"card reveal\"><h3><span class=\"chip c-red\" style=\"margin:0;width:40px;height:40px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"16\" height=\"16\" x=\"4\" y=\"4\" rx=\"2\"></rect><rect width=\"6\" height=\"6\" x=\"9\" y=\"9\" rx=\"1\"></rect><path d=\"M15 2v2\"></path><path d=\"M15 20v2\"></path><path d=\"M2 15h2\"></path><path d=\"M2 9h2\"></path><path d=\"M20 15h2\"></path><path d=\"M20 9h2\"></path><path d=\"M9 2v2\"></path><path d=\"M9 20v2\"></path></svg></span> Technology</h3><div class=\"mem\"><div class=\"avatar s-red\">HT</div><div><b>Hemraj Thapa</b><small>Chief Technology Officer</small></div></div></div>\n    <div class=\"card reveal\"><h3><span class=\"chip c-green\" style=\"margin:0;width:40px;height:40px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 