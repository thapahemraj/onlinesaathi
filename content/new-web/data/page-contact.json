 "regions": {
  "contact-01": "<div class=\"phero\"><div class=\"wrap phero-grid\"><div><div class=\"crumb\"><a href=\"./\">Home</a> / Contact</div><span class=\"eyebrow\" style=\"\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"></path></svg> Get in touch</span><h1 style=\"font-size:clamp(32px,4.4vw,54px);margin-top:14px\">We’re here to <span style=\"color:var(--blue)\">help</span></h1><p class=\"lead\" style=\"margin-top:16px\">Workers, Saathis and business partners — reach the right team by phone, WhatsApp, email or in person.</p></div><div class=\"kpis\"><div class=\"kpi\"><b style=\"font-size:20px\">{{phone_display}}</b><span>helpline & WhatsApp</span></div><div class=\"kpi\"><b style=\"font-size:16px\">{{email_support}}</b><span>email support</span></div></div></div></div>",
  "contact-02": "<div class=\"chapter\" id=\"details\"><div class=\"wrap\"><span class=\"cnum\">01</span><div><b>Contact details & form</b><small>Phone, WhatsApp, email and message form</small></div></div></div>",
  "contact-03": "<section><div class=\"wrap\">\n  <div class=\"grid g3\" style=\"margin-bottom:40px\">\n    <a class=\"card hov reveal\" href=\"workers.php#how-to-get\"><div class=\"chip c-blue\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5\"></path><path d=\"M14 6a6 6 0 0 1 6 6v3\"></path><path d=\"M4 15v-3a6 6 0 0 1 6-6\"></path><rect x=\"2\" y=\"15\" width=\"20\" height=\"4\" rx=\"1\"></rect></svg></div><h3>Workers</h3><p>Help with services and schemes.</p></a>\n    <a class=\"card hov reveal\" href=\"saathi.php#apply\"><div class=\"chip c-green\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7\"></path><path d=\"M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8\"></path><path d=\"M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4\"></path><path d=\"M2 7h20\"></path><path d=\"M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7\"></path></svg></div><h3>Saathis</h3><p>Apply, or get Saathi support.</p></a>\n    <a class=\"card hov reveal\" href=\"business.php#partner-form\"><div class=\"chip c-red\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"m11 17 2 2a1 1 0 1 0 3-3\"></path><path d=\"m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\"></path><path d=\"m21 3 1 11h-2\"></path><path d=\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\"></path><path d=\"M3 4h8\"></path></svg></div><h3>Businesses</h3><p>Partnerships and hiring.</p></a>\n  </div>\n  <div class=\"split\" style=\"align-items:start\">\n    <div class=\"cinfo reveal\">\n      <a href=\"tel:{{phone_tel}}\"><div class=\"chip c-blue\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg></div><div><small>Helpline</small><b>{{phone_display}}</b></div></a>\n      <a href=\"tel:{{phone2_tel}}\"><div class=\"chip c-blue\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z\"></path><path d=\"M14.05 2a9 9 0 0 1 8 7.94\"></path><path d=\"M14.05 6A5 5 0 0 1 18 10\"></path></svg></div><div><small>Alternate number</small><b>{{phone2_display}}</b></div></a>\n      <a href=\"https://wa.me/{{whatsapp}}\" target=\"_blank\" rel=\"noopener\"><div class=\"chip c-green\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"></path></svg></div><div><small>WhatsApp</small><b>Chat with us</b></div></a>\n      <a href=\"mailto:{{email_support}}\"><div class=\"chip c-red\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg></div><div><small>Customer support</small><b>{{email_support}}</b></div></a>\n      <a href=\"mailto:{{email_admin}}\"><div class=\"chip c-amber\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"></polyline><path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"></path></svg></div><div><small>General enquiries</small><b>{{email_admin}}</b></div></a>\n      <a href=\"mailto:{{email_ceo}}\"><div class=\"chip c-blue\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 12h.01\"></path><path d=\"M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2\"></path><path d=\"M22 13a18.15 18.15 0 0 1-20 0\"></path><rect width=\"20\" height=\"14\" x=\"2\" y=\"6\" rx=\"2\"></rect></svg></div><div><small>Partnerships & grievance officer</small><b>{{email_ceo}}</b></div></a>\n    </div>\n    <form class=\"formcard reveal\" data-form=\"Website contact\">\n      <h3 style=\"margin-bottom:18px\">Send us a message</h3>\n      <div class=\"row2\"><div class=\"field\"><label>Name</label><input name=\"Name\" required></div><div class=\"field\"><label>Mobile</label><input name=\"Mobile\" type=\"tel\" required></div></div>\n      <div class=\"row2\"><div class=\"field\"><label>Email (optional)</label><input name=\"Email\" type=\"email\"></div><div class=\"field\"><label>I am a</label><select name=\"Role\"><option>Worker</option><option>Saathi</option><option>Business / partner</option><option>Media</option><option>Other</option></select></div></div>\n      <div class=\"field\"><label>How can we help?</label><textarea name=\"Message\" required></textarea></div>\n      <button class=\"btn btn-blue\" type=\"submit\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"></path><path d=\"m21.854 2.147-10.94 10.939\"></path></svg> Send message</button><div class=\"ok\">Thank you! WhatsApp has opened with your message — just press send.</div>\n    </form>\n  </div>\n</div></section>",
  "contact-04": "<div class=\"chapter\" id=\"location\"><div class=\"wrap\"><span class=\"cnum\">02</span><div><b>Location</b><small>Corporate and registered offices</small></div></div></div>",
  "contact-05": "<section class=\"sec-alt\"><div class=\"wrap\">\n  <div class=\"center reveal\" style=\"margin-bottom:32px\"><span class=\"eyebrow\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg> Location</span><h2>Visit us</h2></div>\n  <div class=\"grid g2\">\n    <div class=\"card reveal\"><div class=\"chip c-blue\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z\"></path><path d=\"M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2\"></path><path d=\"M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2\"></path><path d=\"M10 6h4\"></path><path d=\"M10 10h4\"></path><path d=\"M10 14h4\"></path><path d=\"M10 18h4\"></path></svg></div><h3>Corporate office</h3><p>{{address_office}}</p><a class=\"link\" target=\"_blank\" rel=\"noopener\" href=\"https://www.google.com/maps/search/?api=1&amp;query={{url:map_query}}\">Get directions <svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div>\n    <div class=\"card reveal\"><div class=\"chip c-green\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><line x1=\"3\" x2=\"21\" y1=\"22\" y2=\"22\"></line><line x1=\"6\" x2=\"6\" y1=\"18\" y2=\"11\"></line><line x1=\"10\" x2=\"10\" y1=\"18\" y2=\"11\"></line><line x1=\"14\" x2=\"14\" y1=\"18\" y2=\"11\"></line><line x1=\"18\" x2=\"18\" y1=\"18\" y2=\"11\"></line><polygon points=\"12 2 20 7 4 7\"></polygon></svg></div><h3>Registered office</h3><p>{{company}}, {{address_registered}}</p></div>\n  </div>\n  <iframe class=\"mapframe reveal\" style=\"height:380px;margin-top:22px\" title=\"Online Saathi corporate office map\" loading=\"lazy\" src=\"https://www.google.com/maps?q={{url:map_query}}&amp;output=embed\"></iframe>\n</div></section>",
  "contact-06": "<div class=\"chapter\" id=\"grievance\"><div class=\"wrap\"><span class=\"cnum\">03</span><div><b>Grievance redressal</b><small>Complaints and disputed transactions</small></div></div></div>",
  "contact-07": "<section><div class=\"wrap split\" style=\"align-items:start\">\n  <div class=\"reveal\"><span class=\"eyebrow\" style=\"background:var(--rtint);color:var(--red)\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path><path d=\"M12 7v2\"></path><path d=\"M12 13h.01\"></path></svg> Grievance redressal</span><h2>Had a problem? Tell us.</h2><p class=\"lead\">If you have a complaint about a service, a transaction or a Saathi, write to our Grievance Redressal Officer. For failed or disputed transactions, email support within 48 hours.</p></div>\n  <div class=\"cinfo reveal\">\n    <a href=\"mailto:{{email_ceo}}?subject=Grievance\"><div class=\"chip c-red\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"M12 8v4\"></path><path d=\"M12 16h.01\"></path></svg></div><div><small>Grievance Redressal Officer</small><b>{{email_ceo}}</b></div></a>\n    <a href=\"mailto:{{email_support}}?subject=Disputed%20transaction\"><div class=\"chip c-amber\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z\"></path><path d=\"M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8\"></path><path d=\"M12 17.5v-11\"></path></svg></div><div><small>Failed or disputed transactions (within 48 hours)</small><b>{{email_support}}</b></div></a>\n    <div class=\"ci\"><div class=\"chip c-blue\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><div><small>Policies</small><b><a href=\"terms.php\" style=\"color:var(--blue)\">Terms</a> · <a href=\"privacy.php\" style=\"color:var(--blue)\">Privacy</a> · <a href=\"refund.php\" style=\"color:var(--blue)\">Refunds</a></b></div></div>\n  </div>\n</div></section>",
  "contact-08": "<div class=\"chapter\" id=\"follow\"><div class=\"wrap\"><span class=\"cnum\">04</span><div><b>Follow us</b><small>YouTube, LinkedIn, WhatsApp channel and app</small></div></div></div>",
  "contact-09": "<section class=\"sec-alt\"><div class=\"wrap\"><div class=\"center reveal\"><h2>Follow us</h2><div class=\"social\" style=\"justify-content:center;margin-top:16px\">\n  <a href=\"{{youtube}}\" target=\"_blank\" rel=\"noopener\" style=\"background:var(--tint);color:var(--blue);width:52px;height:52px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17\"></path><path d=\"m10 15 5-3-5-3z\"></path></svg></a>\n  <a href=\"{{linkedin}}\" target=\"_blank\" rel=\"noopener\" style=\"background:var(--tint);color:var(--blue);width:52px;height:52px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"></path><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"></rect><circle cx=\"4\" cy=\"4\" r=\"2\"></circle></svg></a>\n  <a href=\"{{wa_channel}}\" target=\"_blank\" rel=\"noopener\" style=\"background:var(--gtint);color:var(--green);width:52px;height:52px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"></path></svg></a>\n  <a href=\"{{playstore}}\" target=\"_blank\" rel=\"noopener\" style=\"background:var(--tint);color:var(--blue);width:52px;height:52px\"><svg stroke=\"currentColor\" fill=\"none\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"i\" aria-hidden=\"true\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg></a></div></div></div></section>"
